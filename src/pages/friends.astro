---
import MainGridLayout from '../layouts/MainGridLayout.astro';

// 👇 友链数据列表
const items = [
  {
    title: '陈错错',
    imgurl: 'https://q1.qlogo.cn/g?b=qq&nk=123456&s=640', // 记得替换真实头像
    desc: '大二社畜学生',
    siteurl: 'https://chencuocuo.com',
    tags: ['学生'],
  },
  {
    title: 'ZeroQing的个人博客',
    imgurl: 'https://cravatar.cn/avatar/email_hash', // 记得替换真实头像
    desc: '一目洞察网中险，一策化解千般难。',
    siteurl: 'https://zeroqing.com',
    tags: ['技术'],
  },
  {
    title: '阿涛',
    imgurl: 'https://ui-avatars.com/api/?name=At&background=random',
    desc: '欢迎交换友链！',
    siteurl: 'https://www.xllog.top',
    tags: ['站长'],
  },
];
---

<MainGridLayout title="友链" description="我的朋友们">
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full ">
      
      <h1 class="text-3xl font-bold text-black/90 dark:text-white/90 mb-6">友链</h1>
      <p class="mb-6 text-neutral-500">排名不分先后，刷新页面可随机重排。</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8 my-4" id="friends-list">
        {items.map((item) => (
          <div class="friend-card flex flex-nowrap items-stretch h-28 gap-4 rounded-[var(--radius-large)] group">
            <div class="w-28 h-28 flex-shrink-0 rounded-lg overflow-hidden bg-zinc-200 dark:bg-zinc-900">
              <img src={item.imgurl} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="grow w-full flex flex-col justify-between py-1">
              <div>
                <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 mb-1">{item.title}</div>
                <div class="text-neutral-500 text-sm font-medium line-clamp-2">{item.desc}</div>
              </div>
              <!-- 标签展示 -->
              <div class="flex gap-2">
                 {item.tags?.map(tag => (
                     <span class="text-xs bg-neutral-100 dark:bg-neutral-800 text-neutral-500 px-2 py-0.5 rounded-md">{tag}</span>
                 ))}
              </div>
            </div>
            
            <!-- 跳转按钮 -->
            <a href={item.siteurl} target="_blank" rel="noopener noreferrer" class="flex btn-regular w-[3.25rem] h-full items-center justify-center rounded-lg bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" class="transition text-[var(--primary)] text-3xl" width="1em" height="1em" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12.6 12L8.7 8.1q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.6 4.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-4.6 4.6q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7z"></path>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- 评论区占位 -->
      <div id="comments" class="mt-8"></div>
    </div>
  </div>

  <!-- 随机排列脚本 -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('friends-list');
        if (!container) return;
        
        const cards = Array.from(container.children);
        if (cards.length === 0) return;

        // 洗牌算法
        for (let i = cards.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [cards[i], cards[j]] = [cards[j], cards[i]];
        }
        
        // 重新插入
        cards.forEach(card => container.appendChild(card));
    });
  </script>
</MainGridLayout>
