---
import MainGridLayout from '../layouts/MainGridLayout.astro';

// 👇 朋友列表数据（必须在两个 --- 中间）
const friends = [
    {
        name: "阿Lam的破站",
        desc: "大三社畜学生",
        url: "http://47.107.67.111/",
        avatar: "https://q1.qlogo.cn/g?b=qq&nk=123456&s=640"
    },
    {
        name: "ZeroQing的个人博客",
        desc: "一目洞察网中险，一策化解千般难。",
        url: "https://zeroqing.com",
        avatar: "https://cravatar.cn/avatar/email_hash"
    },
    {
        name: "阿涛",
        desc: "欢迎交换友链！",
        url: "https://www.xllog.top",
        avatar: "https://ui-avatars.com/api/?name=At&background=random"
    }
];
---

<MainGridLayout title="友链" description="我的朋友们">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full text-neutral-500/90 gap-4 flex flex-col">
            <h1 class="text-3xl font-bold text-black/90 dark:text-white/90">友链</h1>
            <p>排名不分先后，欢迎留言互换友链！</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                {friends.map((friend) => (
                    <a href={friend.url} target="_blank" class="flex items-center p-4 rounded-xl border border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5 transition-all group">
                        <img src={friend.avatar} alt={friend.name} class="w-16 h-16 rounded-full object-cover mr-4 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform" />
                        <div class="flex flex-col justify-center overflow-hidden">
                            <div class="font-bold text-lg text-black/80 dark:text-white/80 group-hover:text-[var(--primary)] transition-colors truncate">
                                {friend.name}
                            </div>
                            <div class="text-sm text-neutral-400 mt-1 line-clamp-2 leading-relaxed">
                                {friend.desc}
                            </div>
                        </div>
                    </a>
                ))}
            </div>

            <div id="comments" class="mt-8"></div>
        </div>
    </div>
</MainGridLayout>
