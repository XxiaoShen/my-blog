---
import MainGridLayout from '../layouts/MainGridLayout.astro';

// 👇 友链数据列表
const items = [
  {
    title: '阿Lam',
    imgurl: 'https://q1.qlogo.cn/g?b=qq&nk=123456&s=640',
    desc: '大三社畜学生',
    siteurl: 'http://47.107.67.111/',
  },
  {
    title: 'ZeroQing的个人博客',
    imgurl: 'https://cravatar.cn/avatar/email_hash',
    desc: '一目洞察网中险，一策化解千般难。',
    siteurl: 'https://zeroqing.com',
  },
  {
    title: '阿涛',
    imgurl: 'https://ui-avatars.com/api/?name=At&background=random',
    desc: '欢迎交换友链！',
    siteurl: 'https://www.xllog.top',
  },
];
---

<MainGridLayout title="友链" description="我的朋友们">
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      
      <!-- 友链列表标题 -->
      <h1 class="text-3xl font-bold text-black/90 dark:text-white/90 mb-6">友链</h1>
      <p class="mb-6 text-neutral-500">排名不分先后，欢迎交换友链。</p>

      <!-- 友链列表 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-8 my-4">
        {items.map((item) => (
          <div class="friend-card flex items-stretch h-28 gap-4 rounded-[var(--radius-large)]">
            <!-- 头像 -->
            <div class="w-28 h-28 flex-shrink-0 rounded-lg overflow-hidden bg-zinc-200 dark:bg-zinc-900">
              <img src={item.imgurl} alt={item.title} class="w-full h-full object-cover" />
            </div>
            
            <!-- 信息 -->
            <div class="grow w-full flex flex-col justify-between py-1">
              <div>
                <div class="font-bold text-lg text-neutral-900 dark:text-neutral-100 mb-1">{item.title}</div>
                <div class="text-neutral-500 text-sm line-clamp-2">{item.desc}</div>
              </div>
            </div>
            
            <!-- 跳转按钮 -->
            <a href={item.siteurl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-12 rounded-lg bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)]">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="text-[var(--primary)] text-2xl" width="1em" height="1em" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12.6 12L8.7 8.1q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.6 4.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-4.6 4.6q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7z"></path>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- 分隔线 -->
      <hr class="my-8 border-t border-neutral-200 dark:border-neutral-800" />

      <!-- 友链申请规则 -->
      <div class="mb-8">
        <h2 class="text-xl font-bold text-black/90 dark:text-white/90 mb-4">友链申请规则</h2>
        <p class="text-neutral-600 dark:text-neutral-400 mb-4">
          欢迎大佬们添加友链，目前有以下几个要求：
        </p>
        <ul class="list-disc pl-5 space-y-2 text-neutral-600 dark:text-neutral-400">
          <li>您的站点在大陆地区需能正常访问，同时能维持站点的稳定运行。</li>
          <li>您的网站需要有可读的内容，不接受空壳网站的友链。</li>
          <li>如站点有头像，请保证图片能长期稳定地打开。</li>
          <li>您的站点需要保持本站的友链。</li>
          <li>您的站点不可含有违规的内容。</li>
        </ul>
      </div>

      <!-- 本站友链信息 -->
      <div>
        <h2 class="text-xl font-bold text-black/90 dark:text-white/90 mb-4">本站友链信息</h2>
        <div class="flex items-center gap-4 p-4 rounded-lg bg-neutral-100 dark:bg-neutral-900">
          <img 
            src="http://youke.xn--y7xa690gmna.cn/s1/2026/01/21/696fcd0b010bd.webp" 
            alt="小林の小破站"
            class="w-16 h-16 rounded-lg"
          />
          <div>
            <div class="font-bold text-lg">小林の小破站</div>
            <div class="text-neutral-600 dark:text-neutral-400 mb-1">Docker技术分享</div>
            <div class="text-sm text-neutral-500">https://www.xllog.top/</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</MainGridLayout>
