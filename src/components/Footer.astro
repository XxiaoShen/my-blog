---
import { profileConfig } from "../config";

const currentYear = new Date().getFullYear();
---

<footer class="py-8 text-center border-t border-gray-200 dark:border-gray-800 mt-12">
    <div class="container mx-auto px-4">
        <p class="text-gray-600 dark:text-gray-400 mb-4">
            &copy; {currentYear} {profileConfig.name}. 保留所有权利。
        </p>
        <div class="flex justify-center space-x-6">
            <a href="https://www.xllog.top" class="text-gray-500 hover:text-blue-500 transition">
                小林的小破站
            </a>
            <a href="/privacy" class="text-gray-500 hover:text-blue-500 transition">
                隐私政策
            </a>
            <a href="/terms" class="text-gray-500 hover:text-blue-500 transition">
                使用条款
            </a>
            <a href="mailto:your-email@example.com" class="text-gray-500 hover:text-blue-500 transition">
                联系我
            </a>
        </div>
        <p class="text-gray-400 text-sm mt-4">
            🚀 由 Astro 强力驱动
        </p>
    </div>
</footer>
